{
  "id": "s7-neutral",
  "description": "s7video's neutral caption style: white bold sans, hard black shadow, no box, bottom centre inside the social safe zone. Sizes are fractions of the canvas's shorter side; safe-zone margins are fractions of the canvas height (top, bottom) and width (left, right).",
  "font": { "file": "Inter-Bold.ttf", "family": "Inter", "bold": true },
  "colour": { "text": "#FFFFFF", "shadow": "#000000" },
  "chunk": { "minWords": 2, "maxWords": 4, "pauseSeconds": 0.3 },
  "layouts": {
    "portrait": {
      "fontSize": 0.075,
      "shadow": 0.0065,
      "safe": { "top": 0.13, "bottom": 0.26, "left": 0.085, "right": 0.14 }
    },
    "square": {
      "fontSize": 0.07,
      "shadow": 0.006,
      "safe": { "top": 0.08, "bottom": 0.12, "left": 0.07, "right": 0.07 }
    },
    "landscape": {
      "fontSize": 0.065,
      "shadow": 0.0055,
      "safe": { "top": 0.08, "bottom": 0.1, "left": 0.1, "right": 0.1 }
    }
  }
}
