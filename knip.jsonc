{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of our contracts even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  // These executables are supplied by the OS or installed separately from npm.
  "ignoreBinaries": ["eas", "file", "mkfifo", "pkill", "pkg-config", "plutil", "sips"],
  // s7video fork (S7V-002): these exports were only used by apps, packages and host-specific
  // tests the fork removed (mobile, marketing, code hosts, extra providers). They stay so upstream merges apply cleanly;
  // see docs/FORK.md. Prune them only together with the matching upstream code.
  "ignoreIssues": {
    "apps/server/src/git/GitManager.ts": ["exports"],
    "apps/server/src/sourceControl/sourceControlHostSecrets.ts": ["exports"],
    "apps/web/src/components/pullRequest/pullRequestMarkdown.logic.ts": ["exports"],
    "packages/client-runtime/src/state/gitActions.ts": ["exports"],
    "packages/source-control-testing/src/fakeSourceControlDriver.ts": ["exports"],
    "packages/client-runtime/src/operations/projects.ts": ["exports"],
    "packages/client-runtime/src/operations/threadTitle.ts": ["exports"],
    "packages/client-runtime/src/platform/threadCacheEncoding.ts": ["exports"],
    "packages/client-runtime/src/providerClients.ts": ["exports"],
    "packages/client-runtime/src/sourceControlClients.ts": ["exports"],
    "packages/client-runtime/src/state/attachments.ts": ["exports"],
    "packages/client-runtime/src/state/device.ts": ["exports"],
    "packages/client-runtime/src/state/models.ts": ["exports"],
    "packages/client-runtime/src/state/outdatedServerUpdate.ts": ["exports"],
    "packages/client-runtime/src/state/presentation.ts": ["exports"],
    "packages/client-runtime/src/state/projectGrouping.ts": ["exports"],
    "packages/client-runtime/src/state/projects.ts": ["exports"],
    "packages/client-runtime/src/state/shell.ts": ["exports"],
    "packages/client-runtime/src/state/shellPullRequests.ts": ["exports"],
    "packages/client-runtime/src/state/threadState.ts": ["exports"],
    "packages/client-runtime/src/textPaste.ts": ["exports"],
    "packages/client-runtime/src/voice-input/controller.ts": ["exports"],
    "packages/client-runtime/src/voice-input/index.ts": ["exports"],
    "packages/client-runtime/src/voice-input/transcription.ts": ["exports"],
    "packages/contracts/src/composerContext.ts": ["exports"],
    "packages/contracts/src/model.ts": ["exports"],
    "packages/contracts/src/settings.ts": ["exports"],
    "packages/contracts/src/settingsSecretValue.ts": ["exports"],
    "packages/provider-acp/src/server/adapter.ts": ["exports"],
    "packages/provider-core/src/server/maintenanceResolver.ts": ["exports"],
    "packages/provider-core/src/server/snapshotProbe.ts": ["exports"],
    "packages/provider-core/src/server/textGenerationOperations.ts": ["exports"],
    "packages/provider-testing/src/fakeCli.ts": ["exports"],
    "packages/shared/src/cliRelease.ts": ["exports"],
    "packages/shared/src/fileLinks.ts": ["exports"],
    "packages/shared/src/filePreview.ts": ["exports"],
    "packages/shared/src/markdownWindowsPaths.ts": ["exports"],
    "packages/shared/src/remote.ts": ["exports"],
    "packages/shared/src/t3ProjectFile.ts": ["exports"],
    "packages/shared/src/themePalettes.ts": ["exports"],
    "packages/shared/src/themePreview.ts": ["exports"],
    "packages/shared/src/thirdPartyLicenses.ts": ["exports"],
    "packages/shared/src/threadLinks.ts": ["exports"],
    "packages/shared/src/usageLimits.ts": ["exports"],
    "packages/source-control-core/src/server/SourceControlProvider.ts": ["exports"],
    "packages/source-control-core/src/server/discovery.ts": ["exports"],
    "packages/source-control-core/src/server/driver.ts": ["exports"],
    "packages/source-control-core/src/server/pullRequestChecks.ts": ["exports"],
    "packages/source-control-core/src/server/pullRequestUtils.ts": ["exports"],
    "packages/source-control-core/src/shared/definition.ts": ["exports"],
    "packages/source-control-testing/src/TestSourceControlHost.ts": ["exports"],
  },
  "workspaces": {
    ".": {
      // Keep vendored reference repositories outside the root project.
      "project": ["*.{js,mjs,cjs,ts,mts,cts}", ".github/**/*.cjs"],
      "entry": [
        // CodeRabbit loads its configuration by filename.
        ".coderabbit.config.ts",
        ".github/scripts/thread-transfer-report.cjs",
        // The brand config, and the example a white-label build selects with S7VIDEO_CONFIG.
        "s7video.config.ts",
        "configs/*.config.ts",
      ],
      "vite": { "entry": [".github/**/*.test.cjs"] },
      "vitest": { "entry": [".github/**/*.test.cjs"] },
    },
    "scripts": {
      // Knip loads its preprocessor through a CLI option; native verification and
      // worktree setup (from t3.json) run directly. release-desktop.yml bundles the
      // Windows verify script with esbuild through a path knip does not trace, and
      // electron-builder loads the macOS signer by path.
      // release-desktop.yml runs the desktop launch check through xvfb-run, which knip
      // does not trace.
      "entry": [
        // These fixture scripts are injected into a browser page by path.
        "fixtures/*/*.js",
        "knip-schemas.ts",
        "setup-worktree.ts",
        "sign-macos.ts",
        "prepare-server-compile-cache.cjs",
        "smoke-desktop-app.ts",
        "verify-windows-desktop-artifact.ts",
      ],
      "ignoreDependencies": ["esbuild"],
      // The `t3` npm package's files: copied into the package, never imported.
      // knip-schemas.test.ts writes a throwaway project to .knip-test-*, which a
      // knip run beside it in check:changed must not report.
      "ignore": ["npm-launcher/**", ".knip-test-*/**"],
    },
    "apps/server": {
      // Vite+ pack entries and the launcher used by installed background services.
      "entry": [
        "src/bin.ts!",
        "src/claude-history-worker.ts!",
        "scripts/cli.ts",
        "scripts/fetch-expo-schema.ts",
        "scripts/probe-claude-fork-local-rollback-replay.ts",
        "scripts/update-test-shard-weights.ts",
        "scripts/verify-background-live.ts",
        "src/provider/testFixtures/*.mjs",
        // graphqlgen reads its config.
        "graphql.config.ts",
      ],
      // The generated operations export every selection's class.
      "ignoreIssues": { "**/*.graphql.ts": ["exports", "types", "namespaceMembers"] },
      // Keep the transitive Effect runtime pinned for standalone npm installs.
      // The Vite+ web build prerequisite.
      // Native and disk-loaded provider packages stay external to the bundle; the
      // CLI archive and desktop sidecar stage them from this manifest.
      "ignoreDependencies": [
        "@effect/platform-node-shared",
        "@t3tools/web",
        "@napi-rs/keyring",
        "ffi-rs",
      ],
    },
    "apps/desktop": {
      // Electron loads these bundles by filename rather than importing them.
      "entry": [
        "gnome-extension/extension.js!",
        "src/electron/WindowsForegroundFocusWorker.ts!",
        "src/snapShot/GlobalShiftShortcutWorker.ts!",
        "src/snapShot/RegionSnapShotWorker.ts!",
        "src/snapShot/SnapShotAccessibilityWorker.ts!",
        "src/boot.ts!",
        "src/compileCache.ts!",
        "src/serverCompileCache.ts!",
        "src/main.ts!",
        "src/preload.ts!",
        "src/preview-pick-preload.ts!",
        "src/preview-pip-preload.ts!",
        "src/mac-permission-preload.ts!",
        "src/preview/Annotation.css!",
      ],
      // The injected runtime resolves Playwright by string; release tooling runs
      // electron-builder from this workspace, outside its package scripts.
      "ignoreDependencies": ["playwright-core", "electron-builder"],
    },
    "apps/web": {
      // Worktree setup (scripts/setup-worktree.ts) runs this directly, and evidence
      // fixtures run under node.
      "entry": ["scripts/warm-dep-cache.ts", "test/fixtures/**/*.mjs"],
      // UI component modules are copied and adapted as cohesive sets. Keep their
      // named subcomponents even before they have callers; the file audit still
      // reports an entire component module when nothing imports it.
      "ignoreIssues": { "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"] },
    },
    "packages/*": {
      // These workspace packages are private to this monorepo.
      "includeEntryExports": true,
    },
    "packages/effect-acp": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      // Generated upstream protocol definitions are retained as a complete set.
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
    "packages/effect-codex-app-server": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
  },
}
